# 앱이 읽는 환경 변수 전체. 로컬 값은 docker-compose.yml에 들어 있고, 운영 값은 인프라에서 주입한다.

# PostgreSQL 주소 (SQLAlchemy 형식)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/watchlog

# 녹음과 사진을 두는 S3 버킷, 분석 요청 큐
S3_BUCKET=
SQS_QUEUE_URL=

# AWS 리전. 인증 정보는 넣지 않는다 (운영에서는 ECS 태스크 역할을 쓴다)
AWS_DEFAULT_REGION=ap-northeast-2

# 로컬 LocalStack에서만 쓴다. 운영에서는 비워 둔다.
# AWS_ENDPOINT_URL=http://localstack:4566
# S3_PUBLIC_ENDPOINT_URL=http://localhost:4566

# 세션 쿠키에 Secure 속성을 붙일지. HTTPS 운영에서는 true(기본값), 로컬 http에서는 false
COOKIE_SECURE=true

# API 포트와 로그 수준
PORT=8000
LOG_LEVEL=INFO

# 구글 계정 연결 (선택). 둘 다 비어 있으면 연결 버튼이 숨겨지고 익명 전용으로 동작한다.
# PUBLIC_BASE_URL은 사용자가 접속하는 주소이며, 구글 콘솔의 리디렉션 URI와 맞아야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=https://example.com
